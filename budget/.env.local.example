# 이 파일을 복사해서 .env.local 로 만든 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
#   cp .env.local.example .env.local

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI 문서 분석용 (여러 개면 쉼표로 구분). https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 선택 (기본값 gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# 확정된 월별 장부 수정·삭제용 재정 담당자 비밀번호 (코드에 넣지 말고 여기·Vercel 에만)
EDIT_PASSWORD=
